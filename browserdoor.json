{
    "version": "0.1.1",
    "description": "Link picker: choose the Zen space, browser profile or browser for every link you click",
    "homepage": "https://schowave.github.io/browserdoor/",
    "license": "MIT",
    "notes": [
        "Start Browserdoor once (Start menu, or run `browserdoor`), then choose it as your default browser",
        "in the Windows settings it opens. It starts at login from then on."
    ],
    "architecture": {
        "64bit": {
            "url": "https://github.com/schowave/browserdoor/releases/download/windows-v0.1.1/browserdoor-0.1.1-windows-x64.zip",
            "hash": "ffcef3f12d7d82fb2579c90458a666082f2ddde32160a660766a59efe064deab"
        },
        "arm64": {
            "url": "https://github.com/schowave/browserdoor/releases/download/windows-v0.1.1/browserdoor-0.1.1-windows-arm64.zip",
            "hash": "e82e85c19eb4733fecec9e8b50eb9429e14dfa6a526586d3767ee816c55c8fa6"
        }
    },
    "bin": "browserdoor.exe",
    "shortcuts": [
        [
            "browserdoor.exe",
            "Browserdoor"
        ]
    ],
    "uninstaller": {
        "script": "if ($cmd -eq 'uninstall') { & \"$dir\\browserdoor.exe\" --unregister | Out-Null; Start-Sleep -Seconds 2 } else { & \"$dir\\browserdoor.exe\" --quit | Out-Null; Start-Sleep -Seconds 2 }"
    },
    "checkver": {
        "url": "https://github.com/schowave/browserdoor/releases.atom",
        "regex": "releases/tag/windows-v([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/schowave/browserdoor/releases/download/windows-v$version/browserdoor-$version-windows-x64.zip"
            },
            "arm64": {
                "url": "https://github.com/schowave/browserdoor/releases/download/windows-v$version/browserdoor-$version-windows-arm64.zip"
            }
        }
    }
}
